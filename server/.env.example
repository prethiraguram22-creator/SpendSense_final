# SpendSense Backend Environment Variables (Node.js + Express)
# Copy this file to .env and replace placeholders with your actual Supabase credentials.

# Server Port
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=development

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Service Role Secret Key (NEVER expose to frontend or commit to version control)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-key-here

# Frontend Application URL (for CORS and redirect links)
FRONTEND_URL=http://localhost:5173

# Additional Allowed CORS Origins (comma-separated, e.g. for preview deployments)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

