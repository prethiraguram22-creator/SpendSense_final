# SpendSense Frontend Environment Variables (Vite)
# Copy this file to .env and replace placeholders with your actual Supabase credentials.

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key (Safe to expose in frontend client)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Express Backend API Base URL
# Development: http://localhost:5000/api
# Production: https://your-backend-service.onrender.com/api
VITE_API_URL=http://localhost:5000/api

